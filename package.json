{
  "name": "ai-desktop",
  "productName": "一壤 · Yirang",
  "version": "0.66.40",
  "private": true,
  "main": "dist/electron/main.mjs",
  "type": "module",
  "engines": {
    "node": "24.12.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "package": "node scripts/package.mjs",
    "verify:host": "node scripts/diagnose-host.mjs",
    "dev:harness": "node scripts/harness.mjs",
    "desktop:electron": "node scripts/launch-electron.mjs",
    "package:electron": "node scripts/package-installer.mjs",
    "archive:electron": "node scripts/archive-electron.mjs",
    "package:service": "node scripts/package-remote-service.mjs",
    "package:installer": "node scripts/package-installer.mjs",
    "package:electron:dir": "node scripts/package-electron.mjs",
    "test:ux": "node scripts/build.mjs && node --test --test-concurrency=1 tests/ux/*.mjs",
    "test:context": "node --test tests/continuous-context.test.mjs tests/consultation-profile.test.mjs && tsx --test tests/work-context-runtime.test.ts",
    "format": "prettier --write apps packages scripts tests",
    "format:check": "prettier --check apps packages scripts tests"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/mcp-extensions": "0.2.0",
    "@playwright/mcp": "0.0.84",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "exceljs": "4.4.0",
    "fast-formula-parser": "1.0.19",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.4.299",
    "pngjs": "7.0.0",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "5.0.1",
    "sqlite-vec": "0.1.9",
    "ssf": "0.11.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "^45.0.0",
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
